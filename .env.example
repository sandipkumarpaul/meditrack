# MediTrack Environment Configuration
# Copy this file to `.env` and uncomment what you need. Everything is optional.

# SECRET_KEY and CRON_SECRET_TOKEN: if left unset, the app generates a random
# value on first run and persists it to .secret_key / .cron_secret (both
# gitignored) so it survives restarts. Set these explicitly in production so
# the value doesn't depend on that local file surviving.
# SECRET_KEY=
# CRON_SECRET_TOKEN=

# Household local timezone (used for daily reset, reminder timing, and
# displaying timestamps -- dose logs are still stored in UTC).
# APP_TIMEZONE=Asia/Dhaka

# Database URI:
# SQLite (default, zero-setup required):
# DATABASE_URL=sqlite:///meditrack.db
# MySQL (optional):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/meditrack_db

# Web Push (VAPID) keys: generated on first run into vapid_private.pem /
# vapid_public.txt (both gitignored) unless both values are set here.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_EMAIL=admin@example.com

# Rate limiter storage (in-memory is fine for a single process).
# RATELIMIT_STORAGE_URI=memory://

# Development server
# PORT=5000
# FLASK_DEBUG=1
